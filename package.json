{
  "name": "docrot",
  "version": "0.1.0",
  "description": "Find stale documentation: broken links, missing anchors and outdated file paths in your Markdown.",
  "keywords": [
    "markdown",
    "documentation",
    "docs",
    "links",
    "broken-links",
    "lint",
    "cli",
    "ci",
    "github-actions"
  ],
  "license": "MIT",
  "author": "sosoon1113",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sosoon1113/docrot.git"
  },
  "homepage": "https://github.com/sosoon1113/docrot#readme",
  "bugs": "https://github.com/sosoon1113/docrot/issues",
  "type": "module",
  "bin": {
    "docrot": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "fast-glob": "^3.3.3"
  }
}
